# Copy to .env. Everything here is optional.

# Wikimedia asks API clients for a contact (email or URL) in the User-Agent;
# setting it also makes rate limiting less likely during wikipedia_source.py syncs.
WIKIMEDIA_CONTACT=

# TMDB adds backdrops and user reviews. Fill in one of these from https://www.themoviedb.org/settings/api
# The "API Read Access Token" (preferred):
TMDB_READ_TOKEN=
# or the v3 "API Key":
TMDB_API_KEY=
